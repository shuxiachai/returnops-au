# Railway entry for the demonstration (tools/railway/Dockerfile): the web build on
# Railway's PORT, with /v1 and /health proxied to the demo API on 127.0.0.1:8000,
# so the browser stays on one origin. No access log: requests carry bearer tokens.
{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	encode gzip

	handle /v1/* {
		reverse_proxy 127.0.0.1:8000
	}
	handle /health/* {
		reverse_proxy 127.0.0.1:8000
	}
	# Vite names every file under /assets after its content, so a browser may keep it
	# for a year; the page itself is checked again on each load, so a new deployment
	# shows at once (31 October 2026). Only a file that exists gets the long cache: a
	# 404 for a new name, met while a deployment switches, must not be kept for a year.
	handle /assets/* {
		root * /app/web
		@asset file
		header @asset Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /app/web
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
	}
}
