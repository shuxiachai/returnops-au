# Documentation only. Prefer `python tools/environment/local.py init` to
# generate a fresh random local password in the ignored .env file.
# Manual Compose passwords must be URL-safe (letters/digits/_/-); never reuse
# an account credential. Native DATABASE_URL passwords must be URL-encoded.
POSTGRES_USER=returnops_dev
POSTGRES_DB=returnops_f02
POSTGRES_PASSWORD=replace-with-a-local-only-password
DB_PORT=5433
API_PORT=8000
